<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Robô Skatista Cyberpunk - Star Wars Edition</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
        }
        body {
            background-color: #050508;
            color: #fff;
            font-family: 'Courier New', Courier, monospace;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            overflow: hidden;
        }
        #gameCanvas {
            background-color: #0a0a12;
            border: 2px solid #00ffcc;
            box-shadow: 0 0 20px rgba(0, 255, 204, 0.2);
            max-width: 100%;
            max-height: 70vh;
            display: block;
            border-radius: 4px;
        }
        .ui-container {
            text-align: center;
            margin-top: 15px;
        }
        .instructions {
            color: #00ffcc;
            font-size: 14px;
            margin-top: 5px;
            text-shadow: 0 0 5px rgba(0, 255, 204, 0.5);
        }
        #startScreen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(5, 5, 8, 0.95);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }
        #startBtn {
            background: transparent;
            color: #ff5500;
            border: 2px solid #ff5500;
            padding: 15px 30px;
            font-size: 20px;
            font-family: 'Courier New', monospace;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 0 15px #ff5500;
            border-radius: 5px;
            transition: all 0.2s ease;
        }
        #startBtn:hover {
            background: #ff5500;
            color: #000;
            box-shadow: 0 0 25px #ff5500;
        }
    </style>
</head>
<body>

    <audio id="meuAudio" src="data:audio/mp3;base64,";" loop playsinline></audio>

    <div id="startScreen">
        <h1 style="margin-bottom: 10px; text-align: center; font-size: 28px; color: #00ffcc; text-shadow: 0 0 10px #00ffcc;">ROBOT SKATER</h1>
        <h2 style="margin-bottom: 30px; text-align: center; font-size: 16px; color: #ff0055;">STAR WARS EDITION</h2>
        <button id="startBtn">INICIAR JOGO</button>
    </div>

    <canvas id="gameCanvas" width="800" height="300"></canvas>
    
    <div class="ui-container">
        <p class="instructions">Use ESPAÇO, CLIQUE ou TOQUE para pular</p>
    </div>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const bgMusic = document.getElementById('meuAudio');

let gameState = 'START'; 
let score = 0;
let highScore = localStorage.getItem('cyberSkaterHighScore') || 0;
let gameSpeed = 6;
let scoreTimer = 0;

const timeStages = [
    { sky: [10, 10, 25] },     
    { sky: [40, 20, 90] },     
    { sky: [255, 94, 58] },    
    { sky: [135, 206, 235] }   
];
let currentSkyColor = "rgb(10, 10, 25)"; 

function lerp(start, end, amt) {
    return Math.round((1 - amt) * start + amt * end);
}

function updateTimeCycle() {
    let cycleLength = 250; 
    let totalStages = timeStages.length;
    
    let currentStageIdx = Math.floor(score / cycleLength) % totalStages;
    let nextStageIdx = (currentStageIdx + 1) % totalStages;
    
    let progress = (score % cycleLength) / cycleLength;

    let currentStage = timeStages[currentStageIdx];
    let nextStage = timeStages[nextStageIdx];

    let r = lerp(currentStage.sky[0], nextStage.sky[0], progress);
    let g = lerp(currentStage.sky[1], nextStage.sky[1], progress);
    let b = lerp(currentStage.sky[2], nextStage.sky[2], progress);

    currentSkyColor = `rgb(${r}, ${g}, ${b})`;
}

const robot = {
    x: 100, 
    y: 195, 
    width: 40,
    height: 55,
    vy: 0,
    gravity: 0.6, 
    jumpForce: -13.5, 
    isGrounded: false,
    wheelRotation: 0,
    tilt: 0 
};

let obstacles = [];
let particles = [];
let stars = [];
let buildings = [];
let ships = [];

function initBackground() {
    stars = [];
    for (let i = 0; i < 40; i++) {
        stars.push({
            x: Math.random() * canvas.width,
            y: Math.random() * (canvas.height - 120),
            size: Math.random() * 2,
            speed: Math.random() * 0.5 + 0.2
        });
    }

    buildings = [];
    let currentX = 0;
    while (currentX < canvas.width + 250) {
        let bWidth = Math.random() * 50 + 40;
        let bHeight = Math.random() * 100 + 60;
        buildings.push({
            x: currentX,
            y: 250 - bHeight,
            width: bWidth,
            height: bHeight,
            windows: Math.random() > 0.2
        });
        currentX += bWidth + 8;
    }
}

function handleJump() {
    if (gameState === 'PLAYING' && robot.isGrounded) {
        robot.vy = robot.jumpForce; 
        robot.isGrounded = false;
        for (let i = 0; i < 15; i++) {
            particles.push(createParticle(robot.x + robot.width/2, robot.y + robot.height, '#00ffcc'));
        }
    } else if (gameState === 'GAMEOVER') {
        resetGame();
    }
}

window.addEventListener('keydown', (e) => { if (e.code === 'Space') handleJump(); });
canvas.addEventListener('mousedown', handleJump);
canvas.addEventListener('touchstart', (e) => { e.preventDefault(); handleJump(); });

document.getElementById('startBtn').addEventListener('click', () => {
    gameState = 'PLAYING';
    document.getElementById('startScreen').style.display = 'none';
    
    if (bgMusic) {
        try {
            bgMusic.play().catch(err => {
                console.log("Áudio contornado:", err);
            });
        } catch(e) {}
    }
});

function createParticle(x, y, color) {
    return {
        x: x,
        y: y,
        vx: (Math.random() - 0.5) * 6 - 3, 
        vy: (Math.random() - 1.0) * 4, 
        size: Math.random() * 3 + 1,
        color: color,
        life: 1.0,
        decay: Math.random() * 0.07 + 0.03
    };
}

function spawnObstacle() {
    let type = Math.random() > 0.5 ? 'hydrant' : 'skates';
    let width = type === 'hydrant' ? 28 : 45;
    let height = type === 'hydrant' ? 45 : 46; 
    let yPos = 250 - height; 

    obstacles.push({
        x: canvas.width,
        y: yPos,
        width: width,
        height: height,
        type: type
    });
}

function spawnShip() {
    let direction = Math.random() > 0.5 ? 1 : -1;
    let type = Math.random() > 0.5 ? 'xwing' : 'tie';
    ships.push({
        x: direction === 1 ? -60 : canvas.width + 60,
        y: Math.random() * 70 + 20,
        speed: (Math.random() * 1.8 + 1.2) * direction,
        type: type
    });
}

function resetGame() {
    score = 0;
    gameSpeed = 6;
    obstacles = [];
    particles = [];
    ships = [];
    robot.y = 195;
    robot.vy = 0;
    robot.isGrounded = true;
    robot.tilt = 0;
    currentSkyColor = "rgb(10, 10, 25)"; 
    gameState = 'PLAYING';
    
    if (bgMusic) {
        try { bgMusic.currentTime = 0; bgMusic.play().catch(() => {}); } catch(e){}
    }
}

function update() {
    if (gameState !== 'PLAYING') return;

    scoreTimer++;
    if (scoreTimer % 10 === 0) {
        score++;
        if (score % 250 === 0) gameSpeed += 0.5; 
    }

    updateTimeCycle();

    robot.vy += robot.gravity;
    robot.y += robot.vy;

    if (!robot.isGrounded) {
        robot.tilt = Math.max(-0.25, Math.min(0.25, robot.vy * 0.02));
    } else {
        robot.tilt = 0; 
    }

    if (robot.y + robot.height >= 250) {
        if (!robot.isGrounded) {
            for (let i = 0; i < 10; i++) {
                particles.push(createParticle(robot.x + robot.width/2, 248, '#00ffcc'));
            }
        }
        robot.y = 250 - robot.height;
        robot.vy = 0;
        robot.isGrounded = true;
    }

    robot.wheelRotation += gameSpeed * 0.05;

    stars.forEach(star => {
        star.x -= star.speed * (gameSpeed * 0.15); 
        if (star.x < 0) star.x = canvas.width;
    });

    buildings.forEach(b => {
        b.x -= gameSpeed * 0.1;
        if (b.x + b.width < 0) {
            let heights = buildings.map(building => building.x);
            let maxRight = heights.length > 0 ? Math.max(...heights) : canvas.width;
            b.x = maxRight + b.width + 8;
        }
    });

    if (Math.random() < 0.007 && ships.length < 3) {
        spawnShip();
    }

    for (let i = ships.length - 1; i >= 0; i--) {
        ships[i].x += ships[i].speed;
        if (ships[i].x < -80 || ships[i].x > canvas.width + 80) {
            ships.splice(i, 1);
        }
    }

    if (robot.isGrounded && Math.random() > 0.45) { 
        particles.push(createParticle(robot.x + 5, 248, '#00ffcc'));
    }

    if (obstacles.length === 0 || obstacles[obstacles.length - 1].x < canvas.width - (Math.random() * 300 + 380)) {
        spawnObstacle();
    }

    for (let i = obstacles.length - 1; i >= 0; i--) {
        let obs = obstacles[i];
        obs.x -= gameSpeed;

        let r_crash_x = robot.x + 8;
        let r_crash_y = robot.y + 10;
        let r_crash_w = robot.width - 16;
        let r_crash_h = robot.height - 12;

        if (r_crash_x < obs.x + obs.width &&
            r_crash_x + r_crash_w > obs.x &&
            r_crash_y < obs.y + obs.height &&
            r_crash_y + r_crash_h > obs.y) {
            
            try { if (bgMusic) bgMusic.pause(); } catch(e){}
            gameState = 'GAMEOVER';
            if (score > highScore) {
                highScore = score;
                localStorage.setItem('cyberSkaterHighScore', highScore);
            }
            let pColor = obs.type === 'hydrant' ? '#ff0033' : '#ff5500';
            for (let p = 0; p < 25; p++) {
                particles.push(createParticle(obs.x + obs.width/2, obs.y + obs.height/2, pColor));
                particles.push(createParticle(robot.x + robot.width/2, robot.y + robot.height/2, '#00ffcc'));
            }
        }

        if (obs.x + obs.width < 0) {
            obstacles.splice(i, 1);
        }
    }

    for (let i = particles.length - 1; i >= 0; i--) {
        let p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.life -= p.decay;
        if (p.life <= 0) particles.splice(i, 1);
    }
}

function draw() {
    ctx.fillStyle = currentSkyColor;
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    stars.forEach(star => {
        ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
        ctx.fillRect(star.x, star.y, star.size, star.size);
    });

    ships.forEach(ship => {
        ctx.save();
        if (ship.type === 'xwing') {
            ctx.fillStyle = '#cccccc';
            ctx.fillRect(ship.x, ship.y, 24, 4);
            ctx.fillStyle = '#ff3333'; 
            ctx.fillRect(ship.x - 4, ship.y - 5, 5, 14);
            ctx.fillStyle = '#00ffcc';
            let laserX = ship.speed > 0 ? ship.x - 12 : ship.x + 28;
            ctx.fillRect(laserX, ship.y + 1, 8, 1);
        } else {
            ctx.fillStyle = '#445577';
            ctx.fillRect(ship.x + 5, ship.y + 2, 6, 6);
            ctx.fillStyle = '#111122';
            ctx.fillRect(ship.x, ship.y - 5, 3, 20);
            ctx.fillRect(ship.x + 13, ship.y - 5, 3, 20);
            ctx.fillStyle = '#445577';
            ctx.fillRect(ship.x + 2, ship.y + 4, 11, 2);
        }
        ctx.restore();
    });

    buildings.forEach(b => {
        ctx.fillStyle = '#11111d';
        ctx.fillRect(b.x, b.y, b.width, b.height);
        ctx.fillStyle = 'rgba(0, 50, 80, 0.4)';
        ctx.fillRect(b.x, b.y, b.width, 2);

        if (b.windows) {
            ctx.fillStyle = 'rgba(0, 255, 204, 0.3)';
            for (let wx = b.x + 6; wx < b.x + b.width - 6; wx += 12) {
                for (let wy = b.y + 10; wy < 240; wy += 18) {
                    if ((wx + wy) % 3 === 0) {
                        ctx.fillRect(wx, wy, 4, 6);
                    }
                }
            }
        }
    });

    ctx.strokeStyle = 'rgba(20, 20, 40, 0.3)';
    ctx.lineWidth = 1;
    for (let i = 0; i < canvas.width * 1.5; i += 40) {
        ctx.beginPath();
        ctx.moveTo(i - 200, 250);
        ctx.lineTo(i - 400, canvas.height);
        ctx.stroke();
    }

    ctx.strokeStyle = '#00ffcc';
    ctx.lineWidth = 3;
    ctx.shadowBlur = 10;
    ctx.shadowColor = '#00ffcc';
    ctx.beginPath();
    ctx.moveTo(0, 250);
    ctx.lineTo(canvas.width, 250);
    ctx.stroke();
    ctx.shadowBlur = 0; 

    obstacles.forEach(obs => {
        if (obs.type === 'hydrant') {
            ctx.fillStyle = '#ff0033';
            ctx.shadowBlur = 6;
            ctx.shadowColor = '#ff0033';
            ctx.fillRect(obs.x + 4, obs.y + 10, obs.width - 8, obs.height - 10);
            ctx.fillRect(obs.x, obs.y + 18, obs.width, 8);
            ctx.fillStyle = '#888899';
            ctx.shadowColor = '#888899';
            ctx.fillRect(obs.x + 2, obs.y + 4, obs.width - 4, 6);
            ctx.fillRect(obs.x + 9, obs.y, obs.width - 18, 4); 
            ctx.shadowBlur = 0;
        } else {
            ctx.shadowBlur = 4;
            let colors = ['#ff5500', '#ff33aa', '#00ff55', '#ffcc00', '#9900ff'];
            for (let k = 0; k < 5; k++) {
                ctx.fillStyle = colors[k];
                ctx.shadowColor = colors[k];
                let boardY = (obs.y + obs.height - 12) - (k * 8);
                ctx.fillRect(obs.x, boardY, obs.width, 4);
                
                if(k === 0) {
                    ctx.fillStyle = '#00ffcc';
                    ctx.shadowColor = '#00ffcc';
                    ctx.fillRect(obs.x + 6, boardY + 4, 6, 6);
                    ctx.fillRect(obs.x + obs.width - 12, boardY + 4, 6, 6);
                }
            }
            ctx.shadowBlur = 0;
        }
    });

    particles.forEach(p => {
        ctx.fillStyle = p.color;
        ctx.globalAlpha = p.life;
        ctx.fillRect(p.x, p.y, p.size, p.size);
    });
    ctx.globalAlpha = 1.0; 

    if (gameState !== 'GAMEOVER' || scoreTimer % 20 > 10) {
        let rx = robot.x;
        let ry = robot.y;
        
        ctx.save();
        ctx.translate(rx + robot.width / 2, ry + robot.height / 2);
        ctx.rotate(robot.tilt); 
        ctx.translate(-(rx + robot.width / 2), -(ry + robot.height / 2));

        ctx.fillStyle = '#e0e0e0';
        ctx.fillRect(rx + 5, ry + 15, 30, 25);
        ctx.fillStyle = '#0055ff'; 
        ctx.fillRect(rx + 10, ry + 20, 8, 8);
        ctx.fillRect(rx + 24, ry + 20, 6, 15);

        ctx.fillStyle = '#b0b0b0';
        ctx.beginPath();
        ctx.arc(rx + 20, ry + 15, 15, Math.PI, 0);
        ctx.fill();
        
        ctx.fillStyle = '#ff0055';
        ctx.beginPath();
        ctx.arc(rx + 28, ry + 8, 4, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = '#ff5500';
        ctx.shadowBlur = 8;
        ctx.shadowColor = '#ff5500';
        ctx.fillRect(rx - 5, ry + 40, 50, 6);
        ctx.shadowBlur = 0;

        ctx.fillStyle = '#00ffcc';
        ctx.beginPath();
        ctx.arc(rx + 5, ry + 48, 5, 0, Math.PI * 2);
        ctx.arc(rx + 35, ry + 48, 5, 0, Math.PI * 2);
        ctx.fill();

        ctx.restore();
    }

    ctx.font = 'bold 16px "Courier New", monospace';
    ctx.fillStyle = '#00ffcc';
    ctx.fillText(`SCORE: ${score.toString().padStart(5, '0')}`, 20, 35);
    ctx.fillStyle = '#ff5500';
    ctx.fillText(`HI-SCORE: ${highScore.toString().padStart(5, '0')}`, 20, 60);

    if (gameState === 'GAMEOVER') {
        ctx.fillStyle = 'rgba(0,0,0,0.85)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.textAlign = 'center';
        ctx.fillStyle = '#ff0055';
        ctx.font = 'bold 30px "Courier New", monospace';
        ctx.shadowBlur = 10;
        ctx.shadowColor = '#ff0055';
        ctx.fillText('GAME OVER!', canvas.width / 2, canvas.height / 2 - 20);
        ctx.fillStyle = '#00ffcc';
        ctx.shadowColor = '#00ffcc';
        ctx.font = '16px "Courier New", monospace';
        ctx.fillText('Pressione ESPAÇO ou TOQUE para reiniciar', canvas.width / 2, canvas.height / 2 + 25);
        ctx.textAlign = 'left'; 
        ctx.shadowBlur = 0;
    }
}

function gameLoop() {
    update();
    draw();
    requestAnimationFrame(gameLoop);
}

initBackground();
gameLoop();
</script>
</body>
</html>
